# Template only. Do not copy real credentials into Git.
APP_NAME="English Literacy Lab"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.org
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Configure a private production database and dedicated low-privilege user.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ell_production
DB_USERNAME=ell_production
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Configure your reverse proxy's trusted IPs separately.
